# --- Database ---
DATABASE_URL=postgres://pch:pch@localhost:5432/pch

# --- Sites (host-based routing) ---
# Comma separated host names (no port) that serve each site.
HEALING_HOSTS=localhost,127.0.0.1,pureconscioushealing.com,www.pureconscioushealing.com
SHOP_HOSTS=shop.localhost,purecrystalhub.com,www.purecrystalhub.com
HEALING_URL=http://localhost:3005
SHOP_URL=http://shop.localhost:3005

# --- Auth ---
AUTH_SECRET=change-me-to-a-long-random-string

# --- Media storage (absolute or relative to project root) ---
MEDIA_DIR=storage/uploads

# --- Razorpay (leave empty to use built-in test/mock checkout) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email (leave SMTP_HOST empty to log emails to Admin > Notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pure Conscious Healing <pureconscioushealing@gmail.com>"
OWNER_EMAIL=pureconscioushealing@gmail.com

# --- WhatsApp Business API (interakt | gupshup | meta; empty = log only) ---
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
OWNER_WHATSAPP=
